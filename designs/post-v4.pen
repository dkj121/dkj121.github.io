                  "name": "Bio Text Column",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 12,
                  "children": [
                    {
                      "type": "text",
                      "id": "NFDtG",
                      "name": "Author Name",
                      "fill": "$text-primary",
                      "content": "林清",
                      "fontFamily": "Playfair Display",
                      "fontSize": 22,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "E1AR0",
                      "name": "Author Bio",
                      "fill": "$text-secondary",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "林清，生于江南，长于西北。现居北京，从事文学批评与文化研究。著有散文集《夜读札记》《时间的另一种写法》，编有《当代中文散文选》。坚信文字是抵抗时间侵蚀的唯一天然屏障。",
                      "lineHeight": 1.7,
                      "fontFamily": "Newsreader",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
